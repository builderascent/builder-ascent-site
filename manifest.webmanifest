    { "src": "/public/icons/icon-512.png", "sizes": "512x512", "type": "image/png", "purpose": "any" },
    { "src": "/public/icons/icon-maskable-512.png", "sizes": "512x512", "type": "image/png", "purpose": "maskable" }
  ],
  "shortcuts": [
    { "name": "Daily Report", "url": "/forms/daily-report/", "icons": [{ "src": "/public/icons/icon-192.png", "sizes": "192x192" }] },
    { "name": "Pre-Task Plan / JHA", "url": "/forms/safety-planning/", "icons": [{ "src": "/public/icons/icon-192.png", "sizes": "192x192" }] },
    { "name": "Daily Builder Checklist", "url": "/forms/daily-builder/", "icons": [{ "src": "/public/icons/icon-192.png", "sizes": "192x192" }] },
    { "name": "Material Takeoff", "url": "/tools/material-takeoff.html", "icons": [{ "src": "/public/icons/icon-192.png", "sizes": "192x192" }] }
  ]
}
